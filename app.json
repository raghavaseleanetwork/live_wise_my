{
  "expo": {
    "name": "LifeWise",
    "slug": "lifewise",
    "owner": "raghavbaheti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "scheme": "lifewise",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B4B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lifewise"
    },
    "android": {
      "package": "com.lifewise",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_SMS",
        "RECEIVE_SMS",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#B45CE8",
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./logo.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#4F46E5"
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow LifeWise to use Face ID to unlock the app."
        }
      ],
      "expo-web-browser",
      "./app.plugin.js",
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "03a6ca8f-9546-4531-b672-bc74a3b0dc9a"
      }
    }
  }
}
